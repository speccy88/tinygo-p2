diff --git a/compiler/testdata/p2-cabi.go b/compiler/testdata/p2-cabi.go
new file mode 100644
index 0000000..34186b1
--- /dev/null
+++ b/compiler/testdata/p2-cabi.go
@@ -0,0 +1,32 @@
+package main
+
+type p2Pair struct {
+	A uint32
+	B uint32
+	C uint64
+}
+
+//export p2_import_pair
+func p2ImportPair(value p2Pair, salt uint32) uint64
+
+//export p2_export_pair
+func p2ExportPair(value p2Pair, salt uint32) uint64 {
+	return value.C ^ uint64(value.A)<<32 ^ uint64(value.B) ^ uint64(salt)
+}
+
+func p2CallPair(value p2Pair, salt uint32) uint64 {
+	return p2ImportPair(value, salt) + p2ExportPair(value, salt)
+}
+
+//export p2_import_result
+func p2ImportResult(seed uint32) p2Pair
+
+//export p2_export_result
+func p2ExportResult(seed uint32) p2Pair {
+	return p2Pair{A: seed, B: seed + 1, C: uint64(seed)<<32 | uint64(seed)}
+}
+
+func p2CallResult(seed uint32) uint64 {
+	a, b := p2ImportResult(seed), p2ExportResult(seed)
+	return a.C ^ b.C
+}
