--- /dev/null
+++ b/compiler/p2_cabi_test.go
@@ -0,0 +1,117 @@
+package compiler
+
+import (
+	"go/types"
+	"testing"
+
+	"github.com/tinygo-org/tinygo/compileopts"
+	"tinygo.org/x/go-llvm"
+)
+
+func TestP2AggregateCABI(t *testing.T) {
+	if _, err := llvm.GetTargetFromTriple("p2"); err != nil {
+		t.Skip("LLVM was built without the P2 target")
+	}
+	mod, errs := testCompilePackage(t, &compileopts.Options{Target: "p2"}, "p2-cabi.go")
+	defer mod.Dispose()
+	for _, err := range errs {
+		t.Error(err)
+	}
+	if len(errs) != 0 {
+		return
+	}
+	if err := llvm.VerifyModule(mod, llvm.ReturnStatusAction); err != nil {
+		t.Fatal(err)
+	}
+	byvalKind := llvm.AttributeKindID("byval")
+	for _, name := range []string{"p2_import_pair", "p2_export_pair"} {
+		fn := mod.NamedFunction(name)
+		if fn.IsNil() {
+			t.Fatalf("missing function %s", name)
+		}
+		params := fn.GlobalValueType().ParamTypes()
+		if len(params) != 2 || params[0].TypeKind() != llvm.PointerTypeKind || params[1].TypeKind() != llvm.IntegerTypeKind {
+			t.Fatalf("%s has incorrect C ABI: %s", name, fn.String())
+		}
+		byval := fn.GetEnumAttributeAtIndex(1, byvalKind)
+		if byval.IsNil() || byval.GetTypeValue().TypeKind() != llvm.StructTypeKind {
+			t.Fatalf("%s is missing typed byval", name)
+		}
+		align := fn.GetEnumAttributeAtIndex(1, llvm.AttributeKindID("align"))
+		if align.IsNil() || align.GetEnumValue() != 4 {
+			t.Fatalf("%s has incorrect byval alignment", name)
+		}
+		foundCall := false
+		for use := fn.FirstUse(); !use.IsNil(); use = use.NextUse() {
+			call := use.User()
+			if call.IsACallInst().IsNil() {
+				continue
+			}
+			foundCall = true
+			attr := call.GetCallSiteEnumAttribute(1, byvalKind)
+			if attr.IsNil() || attr.GetTypeValue() != byval.GetTypeValue() {
+				t.Errorf("%s call is missing matching byval: %s", name, call.String())
+			}
+		}
+		if !foundCall {
+			t.Errorf("missing call to %s", name)
+		}
+	}
+	for _, name := range []string{"p2_import_result", "p2_export_result"} {
+		fn := mod.NamedFunction(name)
+		if fn.IsNil() || fn.GlobalValueType().ReturnType().TypeKind() != llvm.VoidTypeKind {
+			t.Fatalf("%s must return through sret", name)
+		}
+		attr := fn.GetEnumAttributeAtIndex(1, llvm.AttributeKindID("sret"))
+		if attr.IsNil() || attr.GetTypeValue().TypeKind() != llvm.StructTypeKind {
+			t.Fatalf("%s is missing typed sret", name)
+		}
+		foundCall := false
+		for use := fn.FirstUse(); !use.IsNil(); use = use.NextUse() {
+			call := use.User()
+			if call.IsACallInst().IsNil() {
+				continue
+			}
+			foundCall = true
+			callAttr := call.GetCallSiteEnumAttribute(1, llvm.AttributeKindID("sret"))
+			if callAttr.IsNil() || callAttr.GetTypeValue() != attr.GetTypeValue() {
+				t.Errorf("%s call is missing matching sret: %s", name, call.String())
+			}
+		}
+		if !foundCall {
+			t.Errorf("missing call to %s", name)
+		}
+	}
+}
+
+func TestP2TypeSizes(t *testing.T) {
+	machine, err := NewTargetMachine(&Config{Triple: "p2"})
+	if err != nil {
+		t.Skip("LLVM was built without the P2 target")
+	}
+	defer machine.Dispose()
+	sizes := Sizes(machine)
+	for _, test := range []struct {
+		kind  types.BasicKind
+		align int64
+	}{
+		{types.Int64, 4}, {types.Uint64, 4}, {types.Float64, 8}, {types.Complex128, 8},
+	} {
+		if got := sizes.Alignof(types.Typ[test.kind]); got != test.align {
+			t.Errorf("%s alignment=%d, want %d", types.Typ[test.kind], got, test.align)
+		}
+	}
+	fields := []*types.Var{
+		types.NewVar(0, nil, "head", types.Typ[types.Uint32]),
+		types.NewVar(0, nil, "middle", types.Typ[types.Uint64]),
+		types.NewVar(0, nil, "tail", types.Typ[types.Uint32]),
+	}
+	for i, offset := range sizes.Offsetsof(fields) {
+		if want := []int64{0, 4, 12}[i]; offset != want {
+			t.Errorf("field %d offset=%d, want %d", i, offset, want)
+		}
+	}
+	if size := sizes.Sizeof(types.NewStruct(fields, nil)); size != 16 {
+		t.Errorf("struct size=%d, want 16", size)
+	}
+}
