diff --git a/llvm/test/CodeGen/P2/atomic-opaque.ll b/llvm/test/CodeGen/P2/atomic-opaque.ll
new file mode 100644
index 0000000000..a00339ed4e
--- /dev/null
+++ b/llvm/test/CodeGen/P2/atomic-opaque.ll
@@ -0,0 +1,68 @@
+; RUN: llc -march=p2 -mcpu=generic -verify-machineinstrs < %s | FileCheck %s
+; P2 has no native atomic memory instructions: every shared atomic accesses
+; the common lock-backed runtime, including ordinary loads and stores.
+
+define i32 @load32(ptr %p) {
+; CHECK-LABEL: load32:
+; CHECK: __atomic_load_4
+  %v = load atomic i32, ptr %p seq_cst, align 4
+  ret i32 %v
+}
+
+define void @store32(ptr %p, i32 %v) {
+; CHECK-LABEL: store32:
+; CHECK: __atomic_store_4
+  store atomic i32 %v, ptr %p seq_cst, align 4
+  ret void
+}
+
+define i32 @add32(ptr %p, i32 %v) {
+; CHECK-LABEL: add32:
+; CHECK: __atomic_fetch_add_4
+  %old = atomicrmw add ptr %p, i32 %v seq_cst
+  ret i32 %old
+}
+
+define i32 @exchange32(ptr %p, i32 %v) {
+; CHECK-LABEL: exchange32:
+; CHECK: __atomic_exchange_4
+  %old = atomicrmw xchg ptr %p, i32 %v seq_cst
+  ret i32 %old
+}
+
+define i1 @compare32(ptr %p, i32 %expected, i32 %desired) {
+; CHECK-LABEL: compare32:
+; CHECK: __atomic_compare_exchange_4
+  %pair = cmpxchg ptr %p, i32 %expected, i32 %desired seq_cst seq_cst
+  %ok = extractvalue {i32, i1} %pair, 1
+  ret i1 %ok
+}
+
+define i64 @load64(ptr %p) {
+; CHECK-LABEL: load64:
+; CHECK: __atomic_load_8
+  %v = load atomic i64, ptr %p seq_cst, align 8
+  ret i64 %v
+}
+
+define void @store8(ptr %p, i8 %v) {
+; CHECK-LABEL: store8:
+; CHECK: __atomic_store_1
+  store atomic i8 %v, ptr %p release, align 1
+  ret void
+}
+
+define i64 @load64_aligned4(ptr %p) {
+; CHECK-LABEL: load64_aligned4:
+; CHECK: __atomic_load
+; CHECK-NOT: __atomic_load_8
+  %v = load atomic i64, ptr %p acquire, align 4
+  ret i64 %v
+}
+
+define i64 @add64_aligned4(ptr %p, i64 %v) {
+; CHECK-LABEL: add64_aligned4:
+; CHECK: __atomic_compare_exchange
+  %old = atomicrmw add ptr %p, i64 %v seq_cst, align 4
+  ret i64 %old
+}
diff --git a/llvm/test/CodeGen/P2/boolean-high-bits.ll b/llvm/test/CodeGen/P2/boolean-high-bits.ll
