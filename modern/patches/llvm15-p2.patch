index 0000000000..10682fa388
--- /dev/null
+++ b/llvm/test/CodeGen/P2/boolean-high-bits.ll
@@ -0,0 +1,37 @@
+; RUN: llc -march=p2 -verify-machineinstrs < %s | FileCheck %s
+; Upper bits of a truncated condition are not part of the boolean. In particular,
+; flags2 must choose the false path and flags3 the true path.
+declare void @odd()
+declare void @even()
+
+define void @low_bit_branch(i32 %flags) {
+; CHECK-LABEL: low_bit_branch:
+; CHECK: and r{{[0-9]+}}, #1
+; CHECK: tj{{z|nz}}
+  %bit = trunc i32 %flags to i1
+  br i1 %bit, label %yes, label %no
