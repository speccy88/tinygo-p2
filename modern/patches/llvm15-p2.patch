diff --git a/llvm/test/CodeGen/P2/aggregate-return.ll b/llvm/test/CodeGen/P2/aggregate-return.ll
new file mode 100644
index 0000000000..ccde2d82a1
--- /dev/null
+++ b/llvm/test/CodeGen/P2/aggregate-return.ll
@@ -0,0 +1,52 @@
+; RUN: llc -march=p2 -verify-machineinstrs < %s | FileCheck %s
+; Aggregate Go results must use a hidden result pointer, not reuse R31.
+
+define {i32, i32} @pair(i32 %a, i32 %b) noinline {
+; CHECK-LABEL: pair:
+; CHECK: wrlong
+  %r0 = insertvalue {i32, i32} undef, i32 %a, 0
+  %r1 = insertvalue {i32, i32} %r0, i32 %b, 1
+  ret {i32, i32} %r1
+}
+
+define {i32, i32, i32} @triple(i32 %a, i32 %b, i32 %c) noinline {
+; CHECK-LABEL: triple:
+; CHECK: wrlong
+  %r0 = insertvalue {i32, i32, i32} undef, i32 %a, 0
+  %r1 = insertvalue {i32, i32, i32} %r0, i32 %b, 1
+  %r2 = insertvalue {i32, i32, i32} %r1, i32 %c, 2
+  ret {i32, i32, i32} %r2
+}
+
+define i32 @use_pair(i32 %a, i32 %b) {
+; CHECK-LABEL: use_pair:
+; CHECK: calla
+; CHECK: rdlong
+  %p = call {i32, i32} @pair(i32 %a, i32 %b)
+  %x = extractvalue {i32, i32} %p, 0
+  %y = extractvalue {i32, i32} %p, 1
+  %sum = add i32 %x, %y
+  ret i32 %sum
+}
+
+define i32 @use_triple(i32 %a, i32 %b, i32 %c) {
+; CHECK-LABEL: use_triple:
+; CHECK: calla
+; CHECK: rdlong
+  %p = call {i32, i32, i32} @triple(i32 %a, i32 %b, i32 %c)
+  %x = extractvalue {i32, i32, i32} %p, 0
+  %y = extractvalue {i32, i32, i32} %p, 1
+  %z = extractvalue {i32, i32, i32} %p, 2
+  %xy = add i32 %x, %y
+  %sum = add i32 %xy, %z
+  ret i32 %sum
+}
+
+declare void @llvm.trap() cold noreturn nounwind
+
+define void @stop() noreturn {
+; CHECK-LABEL: stop:
+; CHECK: abort
+  call void @llvm.trap()
+  unreachable
+}
