new file mode 100644
index 0000000000..087a4ffe14
--- /dev/null
+++ b/llvm/test/MC/P2/interrupts.s
@@ -0,0 +1,39 @@
+' RUN: llvm-mc -triple p2 -show-encoding < %s | FileCheck %s
+' RUN: llvm-mc -triple p2 -filetype=obj < %s | llvm-objdump -d - | FileCheck %s --check-prefix=DIS
+' Encodings from P2 Rev B/C silicon v35 interrupt and attention instruction table.
+
+allowi
+' CHECK: allowi {{.*}}encoding: [0x24,0x40,0x60,0xfd]
+' DIS: allowi
+stalli
+' CHECK: stalli {{.*}}encoding: [0x24,0x42,0x60,0xfd]
+' DIS: stalli
+if_z stalli
+' CHECK: if_z stalli {{.*}}encoding: [0x24,0x42,0x60,0xad]
+' DIS: if_z stalli
+setint1 #14
+' CHECK: setint1 #14 {{.*}}encoding: [0x25,0x1c,0x64,0xfd]
+' DIS: setint1 #14
+cogatn r0
+' CHECK: cogatn r0 {{.*}}encoding: [0x3f,0xa0,0x63,0xfd]
+' DIS: cogatn r0
+reti1
+' CHECK: reti1 {{.*}}encoding: [0xf5,0xff,0x3b,0xfb]
+' DIS: reti1
+' _ret_ condition must remain in the instruction high nibble.
+_ret_ allowi
+' CHECK: _ret_ allowi {{.*}}encoding: [0x24,0x40,0x60,0x0d]
+' DIS: _ret_ allowi
+' Large immediate uses AUGD; attention masks may address all cogs.
+cogatn #65535
+' CHECK: augd
+' CHECK: cogatn
+' DIS: augd
+' DIS: cogatn
+' These are single D operands, not S or C/Z operands.
+setint2 r1
+' CHECK: setint2 r1
+' DIS: setint2 r1
+setint3 #0
+' CHECK: setint3 #0
+' DIS: setint3 #0
