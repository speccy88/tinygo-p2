+let Uses = [SW] in defm SUBX   : P2InstCZIDS2i1om<0b0001101, "subx">;
+defm SUBS   : P2InstCZIDS2i1om<0b0001110, "subs">;
+let Uses = [SW] in defm SUBSX  : P2InstCZIDS2i1om<0b0001111, "subsx">;
