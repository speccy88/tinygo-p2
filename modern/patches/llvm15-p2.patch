+++ b/llvm/unittests/ADT/TripleTest.cpp
@@ -2121,4 +2121,16 @@ TEST(TripleTest, isArmMClass) {
     EXPECT_TRUE(T.isArmMClass());
   }
 }
+TEST(TripleTest, P2Architecture) {
+  Triple T("p2-unknown-none");
+  EXPECT_EQ(Triple::p2, T.getArch());
+  EXPECT_EQ(Triple::ELF, T.getObjectFormat());
+  EXPECT_TRUE(T.isArch32Bit());
+  EXPECT_TRUE(T.isLittleEndian());
+  EXPECT_EQ(Triple::p2, T.get32BitArchVariant().getArch());
+  EXPECT_EQ(Triple::p2, T.getLittleEndianArchVariant().getArch());
+  EXPECT_EQ(Triple::UnknownArch, T.get64BitArchVariant().getArch());
+  EXPECT_EQ(Triple::UnknownArch, T.getBigEndianArchVariant().getArch());
+}
+
 } // end anonymous namespace
