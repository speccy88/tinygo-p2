@@ -0,0 +1,25 @@
+// RUN: %clang -O0 -S -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang -O2 -mllvm -verify-machineinstrs -c %s -o %t.o
+
+typedef unsigned long long u64;
+struct integer_pair { unsigned a; u64 b; };
+struct float_pair { unsigned a; double b; };
+_Static_assert(_Alignof(u64) == 4, "i64 must match the LLVM data layout");
+_Static_assert(__builtin_offsetof(struct integer_pair, b) == 4, "integer field offset");
+_Static_assert(sizeof(struct integer_pair) == 12, "integer struct size");
+_Static_assert(_Alignof(double) == 8, "f64 keeps its LLVM natural alignment");
+_Static_assert(__builtin_offsetof(struct float_pair, b) == 8, "float field offset");
+_Static_assert(sizeof(struct float_pair) == 16, "float struct size");
+
+u64 fold_integer(struct integer_pair value, unsigned salt) {
+    return value.b ^ value.a ^ salt;
+}
+// CHECK-LABEL: define{{.*}} @fold_integer(
+// CHECK-SAME: byval(%struct.integer_pair) align 4
+
+unsigned call_integer(unsigned a, u64 b, unsigned salt) {
+    struct integer_pair value = { a, b };
+    return fold_integer(value, salt);
+}
+// CHECK-LABEL: define{{.*}} @call_integer(
+// CHECK: call i64 @fold_integer({{.*}}byval(%struct.integer_pair) align 4
\ No newline at end of file
