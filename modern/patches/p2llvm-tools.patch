diff --git a/libp2/lib/builtins/multi3.ll b/libp2/lib/builtins/multi3.ll
new file mode 100644
index 0000000..97c764b
--- /dev/null
+++ b/libp2/lib/builtins/multi3.ll
@@ -0,0 +1,47 @@
+; Software low 128-bit product for legalizer-generated __multi3 calls.
+; P2 C has no __int128 source type, so express this ABI helper in LLVM IR.
+; All actual multiplications are 64 bits or narrower; never call ourselves.
+; The target legalizer selects the normal P2 hidden-result-pointer ABI.
+
+target triple = "p2"
+
+define i128 @__multi3(i128 %a, i128 %b) nounwind {
+entry:
+  %al = trunc i128 %a to i64
+  %bl = trunc i128 %b to i64
+  %ahs = lshr i128 %a, 64
+  %bhs = lshr i128 %b, 64
+  %ah = trunc i128 %ahs to i64
+  %bh = trunc i128 %bhs to i64
+  %a0 = and i64 %al, 4294967295
+  %a1 = lshr i64 %al, 32
+  %b0 = and i64 %bl, 4294967295
+  %b1 = lshr i64 %bl, 32
+  %p00 = mul i64 %a0, %b0
+  %p01 = mul i64 %a0, %b1
+  %p10 = mul i64 %a1, %b0
+  %p11 = mul i64 %a1, %b1
+  %p00h = lshr i64 %p00, 32
+  %p01l = and i64 %p01, 4294967295
+  %p10l = and i64 %p10, 4294967295
+  %carry0 = add i64 %p00h, %p01l
+  %carry1 = add i64 %carry0, %p10l
+  %carryh = lshr i64 %carry1, 32
+  %p01h = lshr i64 %p01, 32
+  %p10h = lshr i64 %p10, 32
+  %h0 = add i64 %p11, %p01h
+  %h1 = add i64 %h0, %p10h
+  %h2 = add i64 %h1, %carryh
+  %cross0 = mul i64 %ah, %bl
+  %cross1 = mul i64 %al, %bh
+  %h3 = add i64 %h2, %cross0
+  %hi = add i64 %h3, %cross1
+  %p00l = and i64 %p00, 4294967295
+  %carrylo = shl i64 %carry1, 32
+  %lo = or i64 %p00l, %carrylo
+  %lo128 = zext i64 %lo to i128
+  %hi128 = zext i64 %hi to i128
+  %high = shl i128 %hi128, 64
+  %result = or i128 %lo128, %high
+  ret i128 %result
+}
