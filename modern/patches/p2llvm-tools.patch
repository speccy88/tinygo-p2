diff --git a/tests/tools/check_multi3.py b/tests/tools/check_multi3.py
new file mode 100644
index 0000000..1542cc7
--- /dev/null
+++ b/tests/tools/check_multi3.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Check the portable 128-bit multiplication algorithm on a native host.
+
+This verifies the IR arithmetic, not the P2 calling convention or hardware.
+Hardware coverage also needs a target-side wide multiply fixture.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+SOURCE = Path(__file__).resolve().parents[2] / 'libp2/lib/builtins/multi3.ll'
+CASES = r'''
+#include <stdint.h>
+#include <stdio.h>
+typedef unsigned __int128 u128;
+extern u128 __multi3(u128, u128);
+static uint64_t seed = UINT64_C(0xb73d28c4fa193e65);
+static uint64_t next(void) {
+    seed ^= seed << 13;
+    seed ^= seed >> 7;
+    seed ^= seed << 17;
+    return seed;
+}
+static int check(u128 a, u128 b) {
+    u128 got = __multi3(a, b);
+    u128 want = a * b;
+    if (got != want) {
+        fputs("128-bit multiply mismatch\n", stderr);
+        return 1;
+    }
+    return 0;
+}
+int main(void) {
+    const u128 edges[] = {
+        0, 1, 2, ((u128)1 << 31)-1, (u128)1 << 32,
+        ((u128)1 << 64)-1, (u128)1 << 64, (u128)1 << 127,
+        ~(u128)0, ~(u128)1,
+    };
+    for (unsigned i=0; i<sizeof(edges)/sizeof(edges[0]); ++i)
+        for (unsigned j=0; j<sizeof(edges)/sizeof(edges[0]); ++j)
+            if (check(edges[i], edges[j])) return 1;
+    for (unsigned i=0; i<10000; ++i) {
+        u128 a = ((u128)next() << 64) | next();
+        u128 b = ((u128)next() << 64) | next();
+        if (check(a, b)) return 1;
+    }
+    puts("__multi3 host arithmetic: 10100 cases passed");
+    return 0;
+}
+'''
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--host-clang', default='clang')
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix='p2-multi3-') as name:
+        directory = Path(name)
+        cases = directory / 'cases.c'
+        binary = directory / 'check'
+        cases.write_text(CASES)
+        subprocess.run([args.host_clang, '-O2', '-Wno-override-module',
+                        str(cases), str(SOURCE), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+if __name__ == '__main__':
+    main()
