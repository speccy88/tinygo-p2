new file mode 100644
index 0000000..0f0c018
--- /dev/null
+++ b/tests/codegen/gc-sections.ll
@@ -0,0 +1,20 @@
+; RUN: %llc -filetype=obj %s -o %t.o
+; RUN: %bin/ld.lld --gc-sections -e live %t.o -o %t.elf
+; RUN: %bin/llvm-nm %t.elf | FileCheck %s
+; CHECK-NOT: missing_unused_callee
+; CHECK: T live
+; CHECK-NOT: missing_unused_callee
+; CHECK: D used_global
+; CHECK-NOT: missing_unused_callee
+; CHECK-NOT: unused_global
+@used_global = global i32 1
+@unused_global = global i32 0
+declare void @missing_unused_callee()
+define i32 @live() {
+  %v = load volatile i32, ptr @used_global
+  ret i32 %v
+}
+define void @dead() {
+  call void @missing_unused_callee()
+  ret void
+}
